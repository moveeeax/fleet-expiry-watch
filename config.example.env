# Example environment for `fleetwatch fetch`. Copy to .env (git-ignored) and
# replace every REPLACE_ME with a real value. Never commit the filled-in file.
#
# Both sets of credentials are free but must be applied for:
#   DVSA MOT History API  https://documentation.history.mot.api.gov.uk/
#   DVLA Vehicle Enquiry  https://developer-portal.driver-vehicle-licensing.api.gov.uk/
#
# Without these, every other fleetwatch command still works on CSV input alone.

# --- DVSA MOT History API (OAuth2 client credentials + API key) -------------
FLEETWATCH_DVSA_CLIENT_ID=REPLACE_ME
FLEETWATCH_DVSA_CLIENT_SECRET=REPLACE_ME
FLEETWATCH_DVSA_API_KEY=REPLACE_ME
# The token URL DVSA gives you when the key is issued.
FLEETWATCH_DVSA_TOKEN_URL=REPLACE_ME
# Optional: defaults to https://tapi.dvsa.gov.uk/.default
# FLEETWATCH_DVSA_SCOPE=
# Optional: defaults to https://history.mot.api.gov.uk/v1/trade
# FLEETWATCH_DVSA_BASE_URL=

# --- DVLA Vehicle Enquiry Service (API key only) ----------------------------
FLEETWATCH_DVLA_API_KEY=REPLACE_ME
# Optional: point at the UAT host while testing.
# FLEETWATCH_DVLA_BASE_URL=
